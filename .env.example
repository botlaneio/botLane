# Contact options. Leave empty to hide the matching button (nothing fake is ever shown).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
# Booking page embed URL (Cal.com, Calendly, Google appointment page). Must be https.
NEXT_PUBLIC_DEMO_CALENDAR_URL=

# Assessment requests are posted here as JSON: { secret, source, kind, name, email, ... }
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Fallback until the above is set: the partner Google Sheet (see integrations/google-sheets/README.md)
PARTNER_SHEET_WEBHOOK_URL=
PARTNER_SHEET_SECRET=
