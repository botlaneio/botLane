{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botlane",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // botlane.io and www.botlane.io serve this Worker. Deploys create the DNS records
  // and certificates for both; the workers.dev address keeps working too.
  "workers_dev": true,
  "routes": [
    { "pattern": "botlane.io", "custom_domain": true },
    { "pattern": "www.botlane.io", "custom_domain": true }
  ]
}
